PORT=4000
DATABASE_URL=postgresql://fisher:fisher_local_only@localhost:5432/fisher_dev

# Required to enable authenticated API endpoints (HTTPS JWKS URI)
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# Phase 2 is disabled by default. Synthetic development only; never use patient data.
# FISHER_PHASE2_BOOKING_MODE=synthetic
# FISHER_PHASE2_PAYMENT_MODE=staging
# PAYSTACK_SECRET_KEY=sk_test_... (provide securely, do not commit keys)
# Server-side only for patient-web public catalogue/quote proxy:
# FISHER_API_SERVER_URL=http://127.0.0.1:4000/

# Phase 2 OIDC web: set only after choosing an approved identity provider.
# OIDC_ISSUER and OIDC_AUDIENCE apply to both API and web runtimes.
# FISHER_OIDC_CLIENT_ID=
# FISHER_OIDC_CLIENT_SECRET= (optional confidential OIDC client; never commit)
# FISHER_OIDC_AUTHORIZATION_URL=https://id.example/authorize
# FISHER_OIDC_TOKEN_URL=https://id.example/token
# FISHER_OIDC_REDIRECT_URI=https://app.example/auth/callback
# FISHER_WEB_ORIGIN=https://app.example
# FISHER_WEB_SESSION_KEY= (32 cryptographically random bytes encoded as base64url; secret)
# FISHER_AUTH_ALLOW_LOOPBACK_HTTP=synthetic-only (test loopback only, not production)

# Optional gated transactional email provider for synthetic staging.
# No messages are sent if any setting is absent, or in NODE_ENV=production.
# FISHER_PHASE2_EMAIL_MODE=staging
# RESEND_API_KEY= (secret; provide via deployment secret manager)
# FISHER_STAGING_EMAIL_FROM=notifications@your-verified-test-domain.example
# FISHER_STAGING_EMAIL_ALLOWLIST=authorized-test-inbox@example.test (comma-separated)
